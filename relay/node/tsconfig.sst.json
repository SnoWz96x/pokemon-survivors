{
  // sst.config.ts only: its globals ($config, sst, aws) come from .sst/platform (`npx sst install`, no AWS account needed).
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": ["sst.config.ts"]
}
